# Postgres connection (defaults match a standard Homebrew install on macOS)
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=semantic_images

# Where the API listens
API_HOST=127.0.0.1
API_PORT=8000

# CLIP model (small + free). Leave as-is unless you know what you're doing.
CLIP_MODEL=openai/clip-vit-base-patch32
